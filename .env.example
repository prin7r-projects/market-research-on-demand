# Environment variables for the Cited monorepo
# Copy to .env.local (per app) and fill in. NEVER commit real values.

# ---- apps/landing ----
# No runtime secrets required for the landing site.
NEXT_PUBLIC_SITE_URL=https://market-research-on-demand.prin7r.com

# ---- apps/app (deferred) ----
# Stripe checkout for brief intake
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Engine bridge — n8n webhook into company-mktresearch
# ENGINE_QUEUE_URL=https://engine.prin7r.internal/v1/briefs
# ENGINE_HMAC_SECRET=...

# Postgres for the Wasp app (scaffold only)
# DATABASE_URL=postgresql://user:pass@host:5432/cited

# Magic-link delivery email
# RESEND_API_KEY=re_...

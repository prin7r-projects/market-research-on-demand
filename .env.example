# Environment variables for the Cited monorepo
# Copy to .env.local (per app) and fill in. NEVER commit real values.

# ---- apps/landing ----
# Public base URL used for NOWPayments redirect/IPN URLs.
NEXT_PUBLIC_SITE_URL=https://market-research-on-demand.prin7r.com

# ---- NOWPayments (hosted invoice + IPN) ----
# Sourced from the NOWPayments dashboard.
# Names match payments-prototypes/.env.example so the pattern is consistent.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# ---- apps/app (deferred) ----
# Engine bridge — n8n webhook into company-mktresearch
# ENGINE_QUEUE_URL=https://engine.prin7r.internal/v1/briefs
# ENGINE_HMAC_SECRET=...

# Postgres for the Wasp app (scaffold only)
# DATABASE_URL=postgresql://user:pass@host:5432/cited

# ---- Engine: research worker ----
# OpenAI API key for gpt-5-mini (research worker; broker-side)
# OPENAI_API_KEY=sk-...
# Model override (default: gpt-5-mini)
# OPENAI_RESEARCH_MODEL=gpt-5-mini

# Magic-link delivery email
# RESEND_API_KEY=re_...
